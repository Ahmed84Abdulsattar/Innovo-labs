# Copy this file to apps/web/.env.local and fill in the values

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Use the TRANSACTION pooler URL (port 6543) in production — avoids connection exhaustion on serverless.
# Get from: Supabase → Connect → Transaction pooler → URI
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Strongly recommended in production: enables TLS certificate verification.
# Get from: Supabase → Project Settings → Database → SSL certificate (paste PEM contents).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32  (must be at least 32 characters)
JWT_SECRET=your-minimum-32-character-secret-key-here

# ── Azure AD SSO ──────────────────────────────────────────────────────────────
# AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_AD_CLIENT_SECRET=your-client-secret

# ── App ───────────────────────────────────────────────────────────────────────
# Must match your Vercel deployment URL exactly (used for CSRF origin check)
NEXT_PUBLIC_APP_URL=https://innovo-portal.vercel.app

# ── Supabase Storage (file uploads) ──────────────────────────────────────────
# Get from: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database-side Row-Level Security (defense in depth) ──────────────────────
# When 'true', user-facing reads run under Postgres RLS as the `app_rls` role
# (see migration 044 + docs/RLS.md). Leave unset/false until the migration is
# applied AND tested — then flip to 'true'. Reversible by unsetting it.
# RLS_ENFORCED=false

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error  (default: info in production, debug in dev)
# LOG_LEVEL=info
